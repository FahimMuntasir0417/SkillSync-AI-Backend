{
  "name": "SkillSync AI API Routes",
  "baseUrl": "http://localhost:5000",
  "productionBaseUrl": "https://skill-sync-ai-backend.vercel.app",
  "modules": [
    {
      "module": "Health",
      "baseUrl": "",
      "endpoints": [
        {
          "name": "Health Check",
          "method": "GET",
          "url": "/health",
          "notes": "Public route. Confirms the API is running."
        }
      ]
    },
    {
      "module": "Auth",
      "docs": "docs/auth-routes.json",
      "baseUrl": "/api/v1/auth",
      "endpoints": [
        "POST /api/v1/auth/register",
        "POST /api/v1/auth/login",
        "POST /api/v1/auth/refresh-token",
        "POST /api/v1/auth/logout",
        "POST /api/v1/auth/change-password",
        "POST /api/v1/auth/verify-email",
        "POST /api/v1/auth/forget-password",
        "POST /api/v1/auth/reset-password",
        "GET /api/v1/auth/me",
        "GET /api/v1/auth/users/me",
        "GET /api/v1/auth/google",
        "GET /api/v1/auth/login/google",
        "GET /api/v1/auth/google/callback",
        "GET /api/v1/auth/google/success",
        "GET /api/v1/auth/oauth/error"
      ]
    },
    {
      "module": "Users",
      "docs": "docs/user-routes.json",
      "baseUrl": "/api/v1/users",
      "endpoints": [
        "GET /api/v1/users",
        "GET /api/v1/users/me",
        "PATCH /api/v1/users/me",
        "PATCH /api/v1/users/:id/role",
        "PATCH /api/v1/users/:id/block"
      ]
    },
    {
      "module": "Categories",
      "docs": "docs/category-routes.json",
      "baseUrl": "/api/v1/categories",
      "endpoints": [
        "POST /api/v1/categories",
        "GET /api/v1/categories",
        "GET /api/v1/categories/:id",
        "PATCH /api/v1/categories/:id",
        "DELETE /api/v1/categories/:id"
      ]
    },
    {
      "module": "Courses",
      "docs": "docs/course-routes.json",
      "baseUrl": "/api/v1/courses",
      "endpoints": [
        "POST /api/v1/courses",
        "GET /api/v1/courses",
        "GET /api/v1/courses/featured",
        "GET /api/v1/courses/related/:courseId",
        "GET /api/v1/courses/:slug",
        "PATCH /api/v1/courses/:id",
        "DELETE /api/v1/courses/:id"
      ]
    },
    {
      "module": "Course Modules",
      "docs": "docs/course-module-routes.json",
      "baseUrl": "/api/v1/course-modules",
      "endpoints": [
        "POST /api/v1/course-modules",
        "PATCH /api/v1/course-modules/:id",
        "DELETE /api/v1/course-modules/:id"
      ]
    },
    {
      "module": "Lessons",
      "docs": "docs/lesson-routes.json",
      "baseUrl": "/api/v1/lessons",
      "endpoints": [
        "POST /api/v1/lessons",
        "PATCH /api/v1/lessons/:id",
        "DELETE /api/v1/lessons/:id",
        "PATCH /api/v1/lessons/:id/complete"
      ]
    },
    {
      "module": "Enrollments",
      "docs": "docs/enrollment-routes.json",
      "baseUrl": "/api/v1/enrollments",
      "endpoints": [
        "POST /api/v1/enrollments/:courseId",
        "GET /api/v1/enrollments/my-classes",
        "GET /api/v1/enrollments/:id",
        "PATCH /api/v1/enrollments/:id/progress"
      ]
    },
    {
      "module": "Assignments",
      "docs": "docs/assignment-routes.json",
      "baseUrl": "/api/v1/assignments",
      "endpoints": [
        "POST /api/v1/assignments",
        "GET /api/v1/assignments",
        "GET /api/v1/assignments/:id",
        "PATCH /api/v1/assignments/:id",
        "DELETE /api/v1/assignments/:id"
      ]
    },
    {
      "module": "Submissions",
      "docs": "docs/submission-routes.json",
      "baseUrl": "/api/v1/submissions",
      "endpoints": [
        "POST /api/v1/submissions",
        "GET /api/v1/submissions/my-submissions",
        "GET /api/v1/submissions/pending",
        "GET /api/v1/submissions/:id",
        "PATCH /api/v1/submissions/:id/status"
      ]
    },
    {
      "module": "Submission Reviews",
      "docs": "docs/review-routes.json",
      "baseUrl": "/api/v1",
      "endpoints": [
        "POST /api/v1/submissions/:id/review",
        "PATCH /api/v1/reviews/:id",
        "GET /api/v1/reviews/:id"
      ]
    },
    {
      "module": "Course Reviews",
      "docs": "docs/course-review-routes.json",
      "baseUrl": "/api/v1",
      "endpoints": [
        "POST /api/v1/courses/:courseId/reviews",
        "GET /api/v1/courses/:courseId/reviews",
        "PATCH /api/v1/course-reviews/:id",
        "DELETE /api/v1/course-reviews/:id"
      ]
    },
    {
      "module": "Blogs",
      "docs": "docs/blog-routes.json",
      "baseUrl": "/api/v1/blogs",
      "endpoints": [
        "POST /api/v1/blogs",
        "GET /api/v1/blogs",
        "GET /api/v1/blogs/:slug",
        "PATCH /api/v1/blogs/:id",
        "DELETE /api/v1/blogs/:id"
      ]
    },
    {
      "module": "Support",
      "docs": "docs/support-routes.json",
      "baseUrl": "/api/v1/support",
      "endpoints": [
        "POST /api/v1/support/tickets",
        "GET /api/v1/support/tickets",
        "GET /api/v1/support/tickets/:id",
        "PATCH /api/v1/support/tickets/:id/status",
        "POST /api/v1/support/tickets/:id/replies"
      ]
    }
  ]
}
