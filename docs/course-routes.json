{
  "module": "Courses",
  "baseUrl": "/api/v1/courses",
  "endpoints": [
    {
      "name": "Create Course",
      "method": "POST",
      "url": "/api/v1/courses",
      "body": {
        "title": "Complete Backend Development with Node.js",
        "shortDescription": "Learn to build scalable backend APIs with Express, Prisma, and PostgreSQL.",
        "description": "This course teaches API design, authentication, database modeling, validation, and deployment.",
        "thumbnail": "https://example.com/backend-course.png",
        "previewVideoUrl": "https://example.com/preview.mp4",
        "price": 49,
        "level": "INTERMEDIATE",
        "status": "PUBLISHED",
        "durationInHours": 18,
        "categoryId": "category-uuid"
      },
      "notes": "Admin or instructor only. Requires Authorization: Bearer <accessToken>. Instructor ID comes from the logged-in user. Admin can optionally provide instructorId."
    },
    {
      "name": "Get Courses",
      "method": "GET",
      "url": "/api/v1/courses",
      "query": {
        "search": "backend",
        "categoryId": "category-uuid",
        "level": "INTERMEDIATE",
        "status": "PUBLISHED",
        "minPrice": 10,
        "maxPrice": 100,
        "minRating": 4,
        "instructorId": "user-uuid",
        "page": 1,
        "limit": 10,
        "sortBy": "createdAt",
        "sortOrder": "desc"
      },
      "notes": "Public route. Returns published courses only by default. Search works on title, shortDescription, and description."
    },
    {
      "name": "Get Featured Courses",
      "method": "GET",
      "url": "/api/v1/courses/featured",
      "query": {
        "limit": 8
      },
      "notes": "Public route. Published courses only. Sorted by averageRating, totalEnrollments, and createdAt."
    },
    {
      "name": "Get Related Courses",
      "method": "GET",
      "url": "/api/v1/courses/related/:courseId",
      "params": {
        "courseId": "course-uuid"
      },
      "query": {
        "limit": 4
      },
      "notes": "Public route. Returns published courses from the same category and excludes the current course."
    },
    {
      "name": "Get Course By Slug",
      "method": "GET",
      "url": "/api/v1/courses/:slug",
      "params": {
        "slug": "complete-backend-development-with-node-js"
      },
      "notes": "Public route. Returns published course details with category, instructor, modules, lessons, reviews, and enrollment count."
    },
    {
      "name": "Update Course",
      "method": "PATCH",
      "url": "/api/v1/courses/:id",
      "params": {
        "id": "course-uuid"
      },
      "body": {
        "title": "Advanced Backend Development with Node.js",
        "shortDescription": "Build production backend APIs with Express, Prisma, PostgreSQL, and deployment workflows.",
        "description": "Updated course description with more advanced backend engineering topics.",
        "thumbnail": "https://example.com/advanced-backend-course.png",
        "previewVideoUrl": "https://example.com/advanced-preview.mp4",
        "price": 79,
        "level": "ADVANCED",
        "status": "PUBLISHED",
        "durationInHours": 24,
        "categoryId": "category-uuid"
      },
      "notes": "Admin or owner instructor only. Requires Authorization: Bearer <accessToken>. If title changes, slug is regenerated."
    },
    {
      "name": "Delete Course",
      "method": "DELETE",
      "url": "/api/v1/courses/:id",
      "params": {
        "id": "course-uuid"
      },
      "notes": "Admin or owner instructor only. Requires Authorization: Bearer <accessToken>."
    }
  ],
