<!doctype html>
<html lang="en">
  <body style="font-family: Arial, sans-serif; color: #111827; line-height: 1.5">
    <h2>Reset your SkillSync AI password</h2>
    <p>Hello <%= name %>,</p>
    <p>Use the button below to reset your password.</p>
    <p>
      <a
        href="<%= resetUrl %>"
        style="display: inline-block; padding: 10px 16px; background: #2563eb; color: #ffffff; text-decoration: none; border-radius: 6px"
      >
        Reset Password
      </a>
    </p>
    <p>If the button does not work, open this URL:</p>
    <p><%= resetUrl %></p>
    <p>This link expires in 15 minutes.</p>
  </body>
</html>
